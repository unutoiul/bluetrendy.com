# Site
NEXT_PUBLIC_SITE_URL=https://www.bluetrendy.com

# Analytics — Google Analytics and Clarity load only after a visitor accepts the cookie
# banner (UK/EU consent rules), and only on the live site. The bluetrendy.com IDs are built
# in (lib/analyticsConfig.ts); set these only to point at different properties.
# Google Analytics 4: Admin → Data streams → your web stream → Measurement ID (G-…).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity: Settings → Overview → Project ID.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Google Search Console: add the URL-prefix property, choose "HTML tag" and paste only
# the content="…" value. Not needed if you verify the domain through DNS instead.
GOOGLE_SITE_VERIFICATION=

# Cal.com — free individual booking calendar on /book-a-call.
# Connected to the BlueTrendy account; Cal.com creates the Google Meet links.
# The embed uses this public URL. No Cal.com API key is needed at runtime.
NEXT_PUBLIC_CAL_COM_URL=https://cal.com/bluetrendy/discovery-call
# Optional compatibility with an existing Calendly event URL (Cal.com takes priority).
NEXT_PUBLIC_CALENDLY_URL=
# Booking emails: in Cal.com, Settings → Developer → Webhooks, add
# https://www.bluetrendy.com/api/webhooks/cal with the trigger "Booking created"
# and a secret of your choice, then put the same secret here.
CAL_WEBHOOK_SECRET=

# Stripe — paid discovery sprint checkout on /pricing
STRIPE_SECRET_KEY=mk_1TseAtJ6NdQzLZcyGVR6JU6v
STRIPE_DISCOVERY_PRICE_ID=£129
# Optional display price shown on /pricing before checkout (the real amount is set by the Stripe Price above)
NEXT_PUBLIC_DISCOVERY_PRICE_DISPLAY=£950 fixed
# Payment emails: in Stripe, Developers → Webhooks, add
# https://www.bluetrendy.com/api/webhooks/stripe for checkout.session.completed and
# checkout.session.async_payment_succeeded, then paste its signing secret (whsec_…) here.
STRIPE_WEBHOOK_SECRET=

# Resend — every enquiry, booking and discovery-sprint payment sends a notification to
# LEAD_NOTIFICATION_EMAIL and a confirmation to the customer, using hosted templates.
# EMAIL_FROM must be on a domain verified in your Resend account.
# The designs live in emails/templates.ts: `npm run emails -- preview` to look at them,
# `upload` to publish them to Resend, `test` to send all six to LEAD_NOTIFICATION_EMAIL.
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=BlueTrendy Intelligence <contact@bluetrendy.com>
LEAD_NOTIFICATION_EMAIL=contact@bluetrendy.com
