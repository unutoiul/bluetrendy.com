# Site
NEXT_PUBLIC_SITE_URL=https://www.bluetrendy.com

# Cal.com — free individual booking calendar on /book-a-call.
# Connected to the BlueTrendy account; Cal.com creates the Google Meet links.
# The embed uses this public URL. No Cal.com API key is needed at runtime.
NEXT_PUBLIC_CAL_COM_URL=https://cal.com/bluetrendy/discovery-call
# Optional compatibility with an existing Calendly event URL (Cal.com takes priority).
NEXT_PUBLIC_CALENDLY_URL=

# Stripe — paid discovery sprint checkout on /pricing
STRIPE_SECRET_KEY=mk_1TseAtJ6NdQzLZcyGVR6JU6v
STRIPE_DISCOVERY_PRICE_ID=£129
# Optional display price shown on /pricing before checkout (the real amount is set by the Stripe Price above)
NEXT_PUBLIC_DISCOVERY_PRICE_DISPLAY=£950 fixed

# Resend — lead form delivery on /contact (app/api/lead): a notification to
# your team plus a confirmation email back to whoever submitted the form.
# EMAIL_FROM must be on a domain verified in your Resend account.
# Published Resend template aliases: bluetrendy-contact-notification,
# bluetrendy-contact-confirmation. Edit and publish their designs in Resend.
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=BlueTrendy Intelligence <contact@bluetrendy.com>
LEAD_NOTIFICATION_EMAIL=contact@bluetrendy.com
