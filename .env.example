# Site
NEXT_PUBLIC_SITE_URL=https://www.bluetrendy.com

# Calendly — inline booking widget on /book-a-call
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/discovery-call

# Stripe — paid discovery sprint checkout on /pricing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_DISCOVERY_PRICE_ID=price_...
# Optional display price shown on /pricing before checkout (the real amount is set by the Stripe Price above)
NEXT_PUBLIC_DISCOVERY_PRICE_DISPLAY=£950 fixed

# SMTP — lead form delivery on /contact (app/api/lead)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@bluetrendy.com
SMTP_PASS=your-smtp-app-password
LEAD_NOTIFICATION_EMAIL=contact@bluetrendy.com
